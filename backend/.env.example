# ==========================================
# Backend PostgreSQL & Server Environment Template
# ==========================================
# Copy this file to .env and adjust credentials as needed:
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/isetconnect_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here


# --- Security / app settings (all optional, defaults exist for development) ---
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000
UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=*
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@isetconnect.local
ADMIN_PASSWORD=ChangeMe@123
